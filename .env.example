# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI (Gemini 1.5 Flash — FREE tier available)
# Get free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Email
RESEND_API_KEY=

# Lead Sourcing
APOLLO_API_KEY=
HUNTER_API_KEY=
# Google Places API (New) — powers real Lead Scout (Step 11). Never logged.
GOOGLE_PLACES_API_KEY=

# Inngest (use Cloud keys, not Dev)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Set INNGEST_DEV=0 in production
INNGEST_DEV=
NEXT_PUBLIC_INNGEST_DEV_URL=

# ── WhatsApp (Meta Cloud API — FREE) ─────────────────────────────────────────
# Setup: https://developers.facebook.com → My Apps → Create App → Business
# Then: WhatsApp → API Setup

# Found in: Meta Developer Console → WhatsApp → API Setup → Phone Number ID
WHATSAPP_PHONE_NUMBER_ID=

# ⚠️  Use PERMANENT system user token — NOT the temporary 24hr test token
# Create: Business Settings → Users → System Users → Generate Token
# Permissions: whatsapp_business_messaging, whatsapp_business_management
WHATSAPP_ACCESS_TOKEN=

# Any random string you choose — used to verify webhook in Meta Console
WHATSAPP_VERIFY_TOKEN=webiox_wa_hook_2024

# YOUR personal WhatsApp number (Manthan) — for receiving lead alerts
# Format: 918347448241 (91 + 10 digit, no + or spaces)
WHATSAPP_MY_NUMBER=8347448241

# Pre-approved template name from Meta Business Manager (for cold outreach)
# If empty → sends free-form text (only works within 24hr reply window)
WHATSAPP_TEMPLATE_NAME=webiox_cold_outreach

# ── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://unfeelable.ai
